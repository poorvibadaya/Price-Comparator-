{
    "search_debug": true,
    "tiers": {
        "tier1_quickcompare": true,
        "tier2_scrapers": true
    },
    "race": {
        "min_platforms_required": 2,
        "tier1_timeout_seconds": 5,
        "tier2_timeout_seconds": 10,
        "early_return_grace_seconds": 2
    },
    "cache": {
        "l1_max_size": 500,
        "l1_ttl_seconds": 120,
        "l2_redis_ttl_seconds": 600,
        "l2_redis_url": "redis://localhost:6379"
    },
    "platforms": {
        "zepto": {
            "enabled": true,
            "headless": true
        },
        "blinkit": {
            "enabled": true,
            "headless": true
        },
        "swiggy-instamart": {
            "enabled": false,
            "headless": true
        },
        "bigbasket": {
            "enabled": true,
            "headless": true
        },
        "dmart": {
            "enabled": true,
            "headless": true
        }
    },
    "browser_pool": {
        "max_contexts": 5
    },
    "matching": {
        "similarity_threshold": 0.8,
        "strict_matching": true,
        "quantity_tolerance_ratio": 1.1,
        "quantity_tolerance_absolute": 0.1,
        "boost_similarity_on_quantity_match": 0.2,
        "word_similarity_weight": 0.4,
        "sequence_similarity_weight": 0.6
    }
}